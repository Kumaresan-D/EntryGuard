# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - nvr_download.py / upload_downloaded_videos.py
# read these instead of having any credentials hardcoded.

NVR_URL=http://192.168.12.10
NVR_USERNAME=
NVR_PASSWORD=

# Substring matched against the channel dropdown's option labels (e.g. the
# option text is "[A8] North West" - this only needs to match part of it).
NVR_CHANNEL_LABEL=North West

# How many of the search results (top rows) to select for download.
NVR_ROWS_TO_DOWNLOAD=3

# false shows the browser window while debugging selectors against the real
# NVR page; true (default) runs headless, needed for an unattended run via
# setup_scheduled_tasks.ps1.
NVR_HEADLESS=false
    `1
# Optional: a fixed turnstile zone polygon for this camera, as
# "x1,y1,x2,y2,...,xN,yN" (must match config.ZONE_POINT_COUNT points). Pick
# these once via the Streamlit app's zone picker against a frame from this
# camera. Leave unset to upload with plain person detection only (no
# tailgate violation detection).
# NVR_ZONE=120,80,340,90,230,400,150,420

# Reserved ngrok domain run.bat publishes the API on, as a full URL. A
# reserved domain (free ones at https://dashboard.ngrok.com/domains) is what
# makes the public URL constant across restarts - leave unset and run.bat
# still starts ngrok, but with a fresh random URL each time. Needs a one-time
# "ngrok config add-authtoken <token>" (ngrok 3.39+ is what run.bat's --url
# flag expects; "ngrok update" upgrades an older install in place).
# NGROK_DOMAIN=https://entryguard.ngrok-free.app

# --- MinIO object storage for violation screenshots ---
# Leave MINIO_ENDPOINT empty to disable MinIO entirely: screenshots then stay
# on local disk only and the API serves them itself, exactly as before.
# Host:port with no scheme - use MINIO_SECURE for http vs https.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=entryguard-violations
MINIO_SECURE=false

# How long the presigned image URLs in GET /nvr/images/{date} stay valid.
# Capped at 7 days (604800) - AWS SigV4's own maximum, which MinIO enforces.
MINIO_URL_EXPIRY_SECONDS=86400

# Only needed when callers can't reach MINIO_ENDPOINT directly (e.g. the API
# is exposed via ngrok but MinIO is on 127.0.0.1). Presigned URLs get their
# scheme+host swapped for this; the signature still verifies, since SigV4
# signs the path and query rather than the host.
# MINIO_PUBLIC_URL_BASE=https://minio.example.com
